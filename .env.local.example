# BridgePay — Backend API base URL
# Copy this file to .env.local and set the value.
NEXT_PUBLIC_API_URL=http://localhost:8000

# BridgePay-Web — the marketing/introduction site on the main domain.
# "Back to home" links here, not to a route in this app.
NEXT_PUBLIC_WEB_URL=http://localhost:3000

# Stripe publishable key (safe to expose client-side) — needed for the
# card Elements form on /deposit and /payout. Get it from
# https://dashboard.stripe.com/test/apikeys (starts with pk_test_).
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
