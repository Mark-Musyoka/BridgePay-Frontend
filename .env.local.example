# BridgePay — Backend API base URL
# Copy this file to .env.local and set the value.
NEXT_PUBLIC_API_URL=http://localhost:8000

# BridgePay-Web — the marketing/introduction site on the main domain.
# "Back to home" links here, not to a route in this app.
NEXT_PUBLIC_WEB_URL=http://localhost:3000

# Stripe publishable key (safe to expose client-side) — needed for the
# card Elements form on /deposit and /payout. Get it from
# https://dashboard.stripe.com/test/apikeys (starts with pk_test_).
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# Preview mode — sign in with built-in SAMPLE data when no backend is running
# (local UI work only). Adds "Sample user / Sample admin" buttons to /login and
# makes the home page's "Try the live demo" use sample data too. Everything is
# fake and stays in the browser tab.
# NEVER set this to true in a production or staging deployment.
NEXT_PUBLIC_PREVIEW_MODE=false
